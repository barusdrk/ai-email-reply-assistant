{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,

    "allowJs": false,
    "skipLibCheck": true,

    "isolatedModules": true,
    "resolveJsonModule": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "types": [
      "vite/client"
    ],

    "noEmit": true
  },

  "include": [
    "src",
    "vite.config.ts"
  ]
}
