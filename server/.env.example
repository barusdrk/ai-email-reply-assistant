# Server

NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database

MONGODB_URI=mongodb://127.0.0.1:27017/ai-email-reply-assistant
REDIS_URL=redis://127.0.0.1:6379

# Authentication

JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# AI

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

GOOGLE_AI_API_KEY=

# Google OAuth

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/gmail/callback

# Microsoft OAuth

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/outlook/callback

# Stripe

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Limits

FREE_DAILY_LIMIT=5
STARTER_DAILY_LIMIT=100
PRO_DAILY_LIMIT=1000
