# Server

NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database

MONGODB_URI=mongodb://127.0.0.1:27017/ai-email-reply-assistant
REDIS_URL=redis://127.0.0.1:6379

# Authentication

JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# AI

AI_PROVIDER=openai
OPENAI_API_KEY=sample_key
OPENAI_MODEL=gpt-5

GOOGLE_AI_API_KEY=sample_key

# Google OAuth

GOOGLE_CLIENT_ID=sample_id
GOOGLE_CLIENT_SECRET=sample_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/gmail/callback

# Microsoft OAuth

MICROSOFT_CLIENT_ID=sample_id
MICROSOFT_CLIENT_SECRET=sample_secret
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/outlook/callback

# Stripe

STRIPE_SECRET_KEY=sample_key
STRIPE_WEBHOOK_SECRET=sample_secret
STRIPE_STARTER_PRICE_ID=sample_id
STRIPE_PRO_PRICE_ID=sample_id

# Limits

FREE_DAILY_LIMIT=5
STARTER_DAILY_LIMIT=100
PRO_DAILY_LIMIT=1000
