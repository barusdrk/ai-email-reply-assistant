# Server

NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database

MONGODB_URI=mongodb://127.0.0.1:27017/ai-email-reply-assistant
REDIS_URL=redis://127.0.0.1:6379

# Authentication

JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# AI

AI_PROVIDER=Groq

OPENAI_API_KEY=sample_key
OPENAI_MODEL=sample_model

# GEMINI_API_KEY=sample_key
# GEMINI_MODEL=sample_mode

GROQ_API_KEY=sample_key
GROQ_MODEL=sample_model

# ANTHROPIC_API_KEY=sample_key
# CLAUDE_MODEL=sample_model

# Google OAuth

GOOGLE_CLIENT_ID=sample_id
GOOGLE_CLIENT_SECRET=sample_secret
GOOGLE_CALLBACK_URI=http://localhost:3001/api/gmail/callback
GOOGLE_OAUTH_STATE_SECRET=sample_secret

# Microsoft OAuth

MICROSOFT_CLIENT_ID=sample_id
MICROSOFT_CLIENT_SECRET=sample_secret
MICROSOFT_CALLBACK_URI=http://localhost:3001/api/outlook/callback
MICROSOFT_TENANT_ID=change-me

# Stripe

STRIPE_SECRET_KEY=sample_key
STRIPE_WEBHOOK_SECRET=sample_secret
STRIPE_PRICE_STARTER=sample_id
STRIPE_PRICE_PRO=sample_id
STRIPE_BUSINESS_PRICE_ID=sample_id

# Limits

FREE_DAILY_LIMIT=5
STARTER_DAILY_LIMIT=100
PRO_DAILY_LIMIT=1000

# Encryption
ENCRYPTION_KEY=sample_key
TOKEN_ENCRYPTION_KEY=sample_key
