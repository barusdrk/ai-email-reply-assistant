generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  REVIEWER
  ADMIN
}

enum Provider {
  LOCAL
  GOOGLE
  MICROSOFT
}

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum DraftStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SCHEDULED
  SENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String @id @default(auto()) @map("_id") @db.ObjectId
  email              String @unique
  password           String
  name               String?
  avatar             String?
  role               Role @default(USER)
  provider           Provider @default(LOCAL)
  signature          String?
  theme              String? @default("system")
  timezone           String? @default("UTC")
  language           String? @default("en")
  emailNotifications Boolean @default(true)
  aiAutoDraft        Boolean @default(true)
  lastLogin          DateTime?

  connectedAccounts ConnectedAccount[]
  emails            Email[]
  drafts            Draft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConnectedAccount {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user User @relation(fields:[userId],references:[id])

  provider EmailProvider
  providerUserId String
  email String

  accessToken String
  refreshToken String
  tokenType String?
  scope String?

  expiryDate DateTime?

  historyId String?
  webhookId String?
  watchExpiration DateTime?

  connected Boolean @default(true)

  syncStatus String @default("idle")

  lastSyncAt DateTime?
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider,providerUserId])
}

model Email {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user User @relation(fields:[userId],references:[id])

  provider EmailProvider

  messageId String @unique
  threadId String?

  from String
  to String?

  subject String
  preview String
  body String

  unread Boolean @default(true)

  priority String?
  category String?
  summary String?

  receivedAt DateTime?

  drafts Draft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Draft {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user User @relation(fields:[userId],references:[id])

  emailId String @db.ObjectId
  email Email @relation(fields:[emailId],references:[id])

  reply String

  tone String

  length String

  status DraftStatus @default(DRAFT)

  approvedBy String?

  scheduledFor DateTime?

  sentAt DateTime?

  approval Approval?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Approval {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  draftId String @unique @db.ObjectId
  draft Draft @relation(fields:[draftId],references:[id])

  requesterId String @db.ObjectId

  reviewerId String @db.ObjectId

  status ApprovalStatus @default(PENDING)

  comment String?

  requestedAt DateTime @default(now())

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
